# ============================================================
# backend/.env.example — Salin file ini menjadi backend/.env
# Jangan pernah commit file .env ke Git!
# ============================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ────────────────────────────────────────────────
# Gunakan URL ini jika pakai Docker (docker compose up -d)
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/berkesan

# Gunakan URL ini jika install PostgreSQL manual di Windows/Linux
DATABASE_URL=postgresql://postgres:password@localhost:5432/berkesan

# Pool connection
DB_POOL_MAX=20
DB_POOL_MIN=5

# ─── JWT ─────────────────────────────────────────────────────
# Ganti dengan string acak yang panjang dan aman di production!
JWT_SECRET=ganti-dengan-secret-yang-kuat-minimal-32-karakter
JWT_EXPIRES_IN=7d

# ─── Security ────────────────────────────────────────────────
BCRYPT_ROUNDS=10

# CORS — URL frontend yang diizinkan akses backend
# Lokal: http://localhost:3000 atau http://127.0.0.1:5500 (jika pakai Live Server)
# Production: URL tailscale / domain asli dipisah koma
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500

# ─── Payment Gateway ─────────────────────────────────────────
# PAYMENT_GATEWAY=midtrans

# Midtrans
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# sandbox = testing, production = live
# MIDTRANS_ENV=sandbox

# Xendit (isi jika PAYMENT_GATEWAY=xendit)
# XENDIT_SECRET_KEY=
# XENDIT_WEBHOOK_TOKEN=

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
